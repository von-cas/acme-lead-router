    {
      "parameters": {
        "jsCode": "const ledger = $getWorkflowStaticData('global');\nledger.deliveries = ledger.deliveries || {};\nconst capVar = Number($vars.INSTALLER_A_DAILY_CAP);\nconst cap = Number.isFinite(capVar) && capVar > 0 ? capVar : 25;\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Chicago' });\nconst all = Object.entries(ledger.deliveries);\n// Leads held at yesterday's cap go out first thing, oldest first, inside today's cap.\nlet room = cap - all.filter(([, d]) => d.status === 'delivered' && d.day === today).length;\nfor (const [, d] of all.filter(([, d]) => d.status === 'held' && d.day < today && d.payload)\n    .sort((a, b) => a[1].at - b[1].at)) {\n  if (room <= 0) break;\n  Object.assign(d, { status: 'failed', day: today, released_from_cap: true });\n  room -= 1;\n}\nreturn all.filter(([, d]) => d.status === 'failed' && d.attempts < 5 && d.payload)\n  .map(([key, d]) => ({ json: { key, ...d } }));\n"
      },
