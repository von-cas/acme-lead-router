        "jsCode": "// Pass the service's answer through, or build a review-only result when scoring failed.\nif ($json.qualification && $json.lead) return { json: $json };\nconst lead = $('Lead in').item.json;\nreturn { json: {\n  lead: { ...lead, lead_key: null },\n  qualification: { score: 0, tier: 'review', reasons: ['Scoring service unavailable'],\n    summary: 'Scoring service unavailable; review this lead by hand.', source: 'none' },\n} };\n"
