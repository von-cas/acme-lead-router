    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The delivery ledger lives in this workflow's static data, so the replay and the morning check\n// (the other two triggers in this workflow) can read it. n8n saves static data only for\n// production runs of the active workflow, not for manual test runs, and only when a run ends,\n// so two runs at the same moment can both pass this check. A production build keeps the ledger\n// in a database row claimed atomically; the buyer's Idempotency-Key is the backstop.\nconst ledger = $getWorkflowStaticData('global');\nledger.deliveries = ledger.deliveries || {};\nconst { lead } = $('Scored').item.json;\nconst buyer = 'installer-a';\nconst key = `${buyer}:${lead.lead_key}`;\nconst prior = ledger.deliveries[key];\nconst thirtyDays = 30 * 24 * 3600 * 1000;\n// A lead already in flight (sending, waiting for the replay, held at the cap) or waiting for a person\n// (rejected, dead) is handled; a delivered lead is a duplicate for 30 days.\nif (prior && (['sending', 'failed', 'held', 'rejected', 'dead'].includes(prior.status)\n    || (prior.status === 'delivered' && Date.now() - prior.at < thirtyDays))) {\n  return { json: { action: 'duplicate', prior: prior.status } };\n}\nconst capVar = Number($vars.INSTALLER_A_DAILY_CAP);\nconst cap = Number.isFinite(capVar) && capVar > 0 ? capVar : 25;\nconst deliveredToday = Object.values(ledger.deliveries)\n  .filter(d => d.buyer === buyer && d.status === 'delivered' && d.day === lead.day).length;\n// One idempotency key per submission, kept for every retry and replay of it.\nconst entry = { buyer, day: lead.day, at: Date.now(), attempts: 0, contact_id: lead.contact_id,\n  name: lead.first_name, payload: $('Map').item.json, idem: `${lead.lead_key}-${$execution.id}` };\nif (deliveredToday >= cap) {\n  ledger.deliveries[key] = { ...entry, status: 'held' };\n  return { json: { action: 'cap', deliveredToday, cap } };\n}\nledger.deliveries[key] = { ...entry, status: 'sending' };\nreturn { json: { action: 'deliver', deliveredToday, cap, idem: entry.idem } };\n"
      },
