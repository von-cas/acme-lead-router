        "jsCode": "const ledger = $getWorkflowStaticData('global');\nledger.deliveries = ledger.deliveries || {};\nconst day = ms => new Date(ms).toLocaleDateString('en-CA', { timeZone: 'America/Chicago' });\nconst yesterday = day(Date.now() - 864e5);\n// Keep 60 days of history so static data stays small.\nfor (const [key, d] of Object.entries(ledger.deliveries)) {\n  if (Date.now() - d.at > 60 * 864e5) delete ledger.deliveries[key];\n}\nconst rows = Object.values(ledger.deliveries).filter(d => d.day === yesterday);\nconst count = s => rows.filter(d => d.status === s).length;\nconst cap = Number($vars.INSTALLER_A_DAILY_CAP || 25);\nconst text = rows.length === 0\n  ? `No leads were delivered yesterday (${yesterday}). Check the form, workflow 01 and the n8n webhook.`\n  : `Yesterday (${yesterday}): ${count('delivered')} delivered, ${count('failed')} failed, ${count('dead')} dead, `\n    + `${count('held')} held at cap. Installer A cap ${count('delivered')}/${cap}.`;\nreturn [{ json: { text } }];\n"
      },
