    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const err = $json.error;\nconst code = err ? Number(err.status || (String(err.message || '').match(/^(\\d{3})/) || [])[1] || 0) : 200;\nlet status = 'failed';\nif ((!err && $json.buyer_lead_id) || code === 409) status = 'delivered';\nelse if (code >= 400 && code < 500 && code !== 408 && code !== 429) status = 'rejected';\nconst error = status === 'delivered' ? null\n  : (err ? String(err.message || 'unknown error').slice(0, 200) : 'no buyer_lead_id in the answer');\nconst ledger = $getWorkflowStaticData('global');\nconst d = ledger.deliveries[$('Pick deliveries to retry').item.json.key];\nd.attempts += 1;\nd.last_error = error;\nif (status === 'delivered') Object.assign(d, { status, recovered_at: Date.now(),\n  buyer_lead_id: $json.buyer_lead_id || d.buyer_lead_id });\nelse if (status === 'rejected') d.status = 'rejected';\nelse if (d.attempts >= 5) d.status = 'dead';\nreturn { json: { status: d.status, contact_id: d.contact_id, name: d.name, attempts: d.attempts, error } };\n"
      },
