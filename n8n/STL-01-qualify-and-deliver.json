    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Both Deliver outputs land here: classify the answer and write it to the ledger.\nconst err = $json.error;\nconst code = err ? Number(err.status || (String(err.message || '').match(/^(\\d{3})/) || [])[1] || 0) : 200;\nlet status = 'failed';\nif ((!err && $json.buyer_lead_id) || code === 409) status = 'delivered';\nelse if (code >= 400 && code < 500 && code !== 408 && code !== 429) status = 'rejected';\n// Turn '503 - \"{\\\"detail\\\":\\\"down\\\"}\"' into '503 down' for the alert.\nlet error = err ? String(err.message || 'unknown error') : 'no buyer_lead_id in the answer';\nconst parts = error.match(/^(\\d{3}) - (.*)$/s);\nif (parts) {\n  let body = parts[2];\n  try { body = JSON.parse(body); } catch (e) {}\n  try { body = JSON.parse(body).detail || body; } catch (e) {}\n  error = `${parts[1]} ${body}`;\n}\nerror = status === 'delivered' ? null : error.slice(0, 200);\nconst ledger = $getWorkflowStaticData('global');\nconst { lead } = $('Scored').item.json;\nconst d = ledger.deliveries[`installer-a:${lead.lead_key}`];\nObject.assign(d, { status, attempts: d.attempts + 1, at: Date.now(), last_error: error,\n  buyer_lead_id: $json.buyer_lead_id || d.buyer_lead_id });\nreturn { json: { status, name: lead.first_name, contact_id: lead.contact_id, error } };\n"
      },
