    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The delivery ledger lives in this workflow's static data, so the replay and the morning check\n// (the other two triggers in this workflow) can read it. n8n saves static data only for\n// production runs of the active workflow, not for manual test runs.\nconst ledger = $getWorkflowStaticData('global');\nledger.deliveries = ledger.deliveries || {};\nconst { lead } = $('Scored').item.json;\nconst buyer = 'installer-a';\nconst prior = ledger.deliveries[`${buyer}:${lead.lead_key}`];\nconst thirtyDays = 30 * 24 * 3600 * 1000;\nif (prior && prior.status === 'delivered' && Date.now() - prior.at < thirtyDays) {\n  return { json: { action: 'duplicate' } };\n}\nconst cap = Number($vars.INSTALLER_A_DAILY_CAP || 25);\nconst deliveredToday = Object.values(ledger.deliveries)\n  .filter(d => d.buyer === buyer && d.status === 'delivered' && d.day === lead.day).length;\nif (deliveredToday >= cap) {\n  ledger.deliveries[`${buyer}:${lead.lead_key}`] = { buyer, status: 'held', day: lead.day, at: Date.now(),\n    attempts: 0, contact_id: lead.contact_id, name: lead.first_name };\n  return { json: { action: 'cap', deliveredToday, cap } };\n}\nreturn { json: { action: 'deliver', deliveredToday, cap } };\n"
      },
